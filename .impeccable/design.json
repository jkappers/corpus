  "narrative": {
    "northStar": "The Quiet Ledger",
    "overview": "Corpus looks like a well-kept record: ruled lines, tight rows, neutral paper, and a single blue used to mark what is active or actionable. Nothing decorates. Structure comes from hairlines and tonal steps between ground, rail, and raised surfaces, not from shadows or color.",
    "keyCharacteristics": [
      "Flat by default; hairlines do the work of shadows.",
      "One accent, Signal Blue, never decorative.",
      "4px maximum radius; 2px for tags and inline code.",
      "Dense controls, tabular numerals on, one typeface plus mono.",
      "Brand lives in precision, not ornament."
    ],
    "rules": [
      { "name": "The One Voice Rule", "body": "Signal Blue is the only chromatic accent. Status colors mark state, never emphasis.", "section": "colors" },
      { "name": "The Twin Rule", "body": "Every color is defined in both themes. A new token ships with its dark value or not at all.", "section": "colors" },
      { "name": "The Weight Not Size Rule", "body": "Inside chrome, separate levels with weight (400/500/600) and ink tone before reaching for a larger size.", "section": "typography" },
      { "name": "The Hairline Rule", "body": "Separate with a 1px border before adding a shadow. Shadows are reserved for things that float.", "section": "elevation" }
    ],
    "dos": [
      "Do separate regions with 1px Rule or Line borders.",
      "Do use Signal Blue for the single most important action, current state, and focus.",
      "Do define every new color in light and dark.",
      "Do keep controls at 28px (44px on coarse pointers).",
      "Do use the .input, .label, .tag, .th, .tr component classes before writing new styles."
    ],
    "donts": [
      "Don't add shadows to resting surfaces.",
      "Don't exceed a 4px radius or use pill shapes.",
      "Don't introduce a second accent color.",
      "Don't use color alone for status; pair it with text or an icon.",
      "Don't enlarge chrome type to create hierarchy; use weight and ink tone."
    ]
  }
